{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "demo.escalatunegocioconia.com" }],
      "destination": "https://creador-contenido.escalatunegocioconia.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
